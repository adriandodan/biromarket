@model IList<ProductOverviewModel>
@{
    var carouselTitle = ViewData["CarouselTitle"]?.ToString() ?? string.Empty;
    var carouselId = ViewData["CarouselId"]?.ToString() ?? string.Empty;
}

@if (Model.Count > 0)
{
    <section class="bm-product-carousel" aria-labelledby="@carouselId">
        <div class="bm-product-carousel-heading">
            <span class="bm-marketing-eyebrow">BIROMARKET / SELECȚIE</span>
            <h2 id="@carouselId">@carouselTitle</h2>
        </div>
        <div class="product-grid">
            <div class="item-grid" role="list" tabindex="0" aria-label="@carouselTitle">
                @foreach (var product in Model)
                {
                    <div class="item-box" role="listitem">
                        @await Html.PartialAsync("_ProductBox", product)
                    </div>
                }
            </div>
        </div>
    </section>
}
