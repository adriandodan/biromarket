@model CategoryNavigationModel

@using Nop.Core.Domain.Catalog

@functions {
    bool BreadCrumbContainsCurrentCategoryId(CategorySimpleModel category)
    {
        if (Model.CurrentCategoryId == 0)
            return false;

        if (category.Id == Model.CurrentCategoryId)
            return true;

        foreach (var subCategory in category.SubCategories)
        {
            if (BreadCrumbContainsCurrentCategoryId(subCategory))
            {
                return true;
            }
        }

        return false;
    }

    async Task CategoryLine(CategoryNavigationModel.CategoryLineModel lineModel)
    {
        var active = BreadCrumbContainsCurrentCategoryId(lineModel.Category);
        var last = lineModel.Category.Id == lineModel.CurrentCategoryId;
        var liClass = active ? "active" : "inactive";
        var sublistId = $"category-sublist-{lineModel.Category.Id}";
        if (last)
        {
            liClass += " last";
        }

        <li class="@liClass">
            <a href="@(Url.RouteUrl<Category>(new { SeName = lineModel.Category.SeName }))" aria-current="@(last ? "page" : null)">
                <span class="category-name">@lineModel.Category.Name</span>
                @if (lineModel.Category.NumberOfProducts.HasValue)
                {
                    <span class="category-count">@T("Categories.TotalProducts", lineModel.Category.NumberOfProducts.Value)</span>
                }
            </a>
            @if (lineModel.Category.SubCategories.Count > 0)
            {
                <button type="button"
                        class="category-toggle"
                        aria-expanded="@(active ? "true" : "false")"
                        aria-controls="@sublistId"
                        aria-label="@T("Categories") - @lineModel.Category.Name">
                    <span class="category-toggle-icon" aria-hidden="true"></span>
                </button>
                <ul id="@sublistId" class="sublist" hidden="@(active ? null : "hidden")">
                    @foreach (var subCategory in lineModel.Category.SubCategories)
                    {
                        var categoryLineModel = new CategoryNavigationModel.CategoryLineModel
                        {
                            CurrentCategoryId = lineModel.CurrentCategoryId,
                            Category = subCategory
                        };
                        await CategoryLine(categoryLineModel);
                    }
                </ul>
            }
        </li>
    }
}

@if (Model.Categories.Count > 0)
{
    <div class="block block-category-navigation">
        <div class="title">
            <strong>@T("Categories")</strong>
        </div>
        <div class="listbox">
            <ul class="list">
                @foreach (var category in Model.Categories)
                {
                    var categoryLineModel = new CategoryNavigationModel.CategoryLineModel
                    {
                        CurrentCategoryId = Model.CurrentCategoryId,
                        Category = category
                    };
                    await CategoryLine(categoryLineModel);
                }
            </ul>
        </div>
    </div>
    <script asp-location="Footer">
        $(function () {
            $(document)
                .off('click.bmCategoryNavigation', '.block-category-navigation .category-toggle')
                .on('click.bmCategoryNavigation', '.block-category-navigation .category-toggle', function () {
                    var $toggle = $(this);
                    var expanded = $toggle.attr('aria-expanded') === 'true';
                    $toggle.attr('aria-expanded', String(!expanded));
                    $toggle.siblings('.sublist').first().prop('hidden', expanded);
                });
        });
    </script>
}