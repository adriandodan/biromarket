@model IList<ProductOverviewModel>
@{
    var carouselViewData = new ViewDataDictionary(ViewData)
    {
        ["CarouselTitle"] = T("Products.RecentlyViewedProducts"),
        ["CarouselId"] = "bm-products-recently-viewed-title"
    };
}
@await Html.PartialAsync("_ProductCarousel", Model, carouselViewData)
