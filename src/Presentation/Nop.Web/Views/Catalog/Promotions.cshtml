@model CatalogProductsModel
@{
    Layout = "_ColumnsOne";

    NopHtml.AddTitleParts("Promotii");
    NopHtml.AppendPageCssClassParts("html-promotions-page");
}

<main class="bm-promotions-page">
    <section class="bm-promotions-hero" aria-labelledby="promotions-title">
        <div class="bm-promotions-copy">
            <span class="bm-promotions-kicker">OCAZII BUNE, PREȚURI MAI MICI</span>
            <h1 id="promotions-title">Promotii</h1>
            <p>Produse alese pentru tine, acum la prețuri speciale. Descoperă oferta și profită cât timp este disponibilă.</p>
            <a class="bm-promotions-cta" href="#promotions-products">Vezi produsele la reducere <span aria-hidden="true">&darr;</span></a>
        </div>
        <div class="bm-promotions-stamp" aria-hidden="true">
            <span>PREȚURI</span>
            <strong>MAI<br />MICI</strong>
            <span>OFERTE ACTIVE</span>
        </div>
        <span class="bm-promotions-spark bm-promotions-spark-one" aria-hidden="true">✳</span>
        <span class="bm-promotions-spark bm-promotions-spark-two" aria-hidden="true">✳</span>
    </section>

    <section class="bm-promotions-list" id="promotions-products" aria-labelledby="promotions-list-title">
        <div class="bm-promotions-heading">
            <div>
                <span class="bm-promotions-kicker">MERITĂ SĂ LE PRINZI</span>
                <h2 id="promotions-list-title">Oferte în desfășurare</h2>
            </div>
            @if (Model.Products.Count > 0)
            {
                <span class="bm-promotions-count">@Model.Products.Count produse la ofertă</span>
            }
        </div>
        @await Html.PartialAsync("_ProductsInGridOrLines", Model)
    </section>
</main>
