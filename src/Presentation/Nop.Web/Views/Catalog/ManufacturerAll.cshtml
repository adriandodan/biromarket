@model IList<ManufacturerModel>

@using Nop.Core.Domain.Catalog

@{
    Layout = "_ColumnsOne";
    NopHtml.AddTitleParts(T("PageTitle.Manufacturers").Text);
    NopHtml.AppendPageCssClassParts("html-manufacturer-list-page");
    NopHtml.AppendPageCssClassParts("html-bm-marketing-page");
}

<div class="bm-marketing-page bm-manufacturer-directory">
    <section class="bm-marketing-hero bm-marketing-hero-compact">
        <span class="bm-marketing-eyebrow">BIROMARKET / BRANDURI</span>
        <h1>Branduri care dau formă ideilor.</h1>
        <p>Descoperă brandurile prezente în magazin și explorează selecția lor de produse pentru birou, școală și creație.</p>
    </section>

    <section class="bm-marketing-section" aria-labelledby="bm-manufacturers-heading">
        <div class="bm-marketing-section-heading">
            <span class="bm-marketing-eyebrow">GĂSEȘTE-ȚI PREFERATELE</span>
            <h2 id="bm-manufacturers-heading">Un catalog de branduri, pregătit pentru ideile tale.</h2>
            <p>Alege un brand pentru a descoperi produsele disponibile în magazin.</p>
            <span class="bm-brand-count"><strong>@Model.Count</strong> branduri în catalog</span>
        </div>
        @if (Model.Count > 0)
        {
            <div class="bm-brand-grid">
                @foreach (var brand in Model)
                {
                    var imageUrl = brand.PictureModel.ImageUrl;
                    var hasBrandImage = !string.IsNullOrWhiteSpace(imageUrl) && !imageUrl.Contains("default-image", StringComparison.OrdinalIgnoreCase);
                    <a class="bm-brand-card" href="@(Url.RouteUrl<Manufacturer>(new { SeName = brand.SeName }))">
                        <span class="bm-brand-picture">
                            @if (hasBrandImage)
                            {
                                <img src="@imageUrl" alt="@brand.PictureModel.AlternateText" title="@brand.PictureModel.Title" loading="lazy" />
                            }
                            else
                            {
                                <span class="bm-brand-monogram" aria-hidden="true">@(string.IsNullOrWhiteSpace(brand.Name) ? "B" : brand.Name.Substring(0, 1).ToUpperInvariant())</span>
                            }
                        </span>
                        <span class="bm-brand-name">@brand.Name</span>
                        <span class="bm-brand-arrow" aria-hidden="true">&nearr;</span>
                    </a>
                }
            </div>
        }
        else
        {
            <p class="bm-brand-empty">Momentan nu sunt branduri disponibile. Revino în curând pentru noutăți.</p>
        }
    </section>
</div>
