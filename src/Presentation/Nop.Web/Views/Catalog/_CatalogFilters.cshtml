@model CatalogProductsModel

@if (!Model.PriceRangeFilter.Enabled &&
     !Model.SpecificationFilter.Enabled &&
     !Model.ManufacturerFilter.Enabled)
{
    return;
}

<div class="block product-filters">
    @if (Model.PriceRangeFilter.Enabled)
    {
        @await Html.PartialAsync("_FilterPriceBox", Model.PriceRangeFilter)
    }

    @if (Model.SpecificationFilter.Enabled)
    {
        @await Html.PartialAsync("_FilterSpecsBox", Model.SpecificationFilter)
    }

    @if (Model.ManufacturerFilter.Enabled)
    {
        @await Html.PartialAsync("_FilterManufacturerBox", Model.ManufacturerFilter)
    }
</div>

<script asp-location="Footer">
    $(function() {
        // Function to check if we're on mobile
        function isMobile() {
            var e = window, a = 'inner';
            if (!('innerWidth' in window)) {
                a = 'client';
                e = document.documentElement || document.body;
            }
            var result = { width: e[a + 'Width'], height: e[a + 'Height'] };
            return result.width < 1001;
        }

        // Initialize mobile filter behavior
        function initializeMobileFilters() {
            if (isMobile()) {
                // Hide filters by default on mobile
                $('.block .filter-content').hide();
                
                // Add mobile class and cursor pointer to filter titles for visual feedback
                $('.block .filter-title').addClass('mobile-collapsible').css('cursor', 'pointer');
                
                // Add collapse/expand indicators
                $('.block .filter-title').each(function() {
                    if (!$(this).find('.mobile-toggle-icon').length) {
                        $(this).append('<span class="mobile-toggle-icon" style="float: right; font-size: 12px;">▼</span>');
                    }
                });
            } else {
                // Show filters on desktop and remove mobile styling
                $('.block .filter-content').show();
                $('.block .filter-title').removeClass('mobile-collapsible').css('cursor', '');
                $('.block .filter-title .mobile-toggle-icon').remove();
            }
        }

        // Handle filter title clicks - ONLY on mobile and ONLY on the title
        $('.block .filter-title').on('click', function(e) {
            e.preventDefault(); // Prevent any default behavior
            e.stopPropagation(); // Stop event from bubbling up
            
            if (isMobile()) {
                var $filterContent = $(this).siblings('.filter-content');
                var $icon = $(this).find('.mobile-toggle-icon');
                
                // Toggle the content with smooth animation
                $filterContent.slideToggle('slow', function() {
                    // Update icon based on visibility
                    if ($filterContent.is(':visible')) {
                        $icon.text('▲'); // Up arrow when expanded
                    } else {
                        $icon.text('▼'); // Down arrow when collapsed
                    }
                });
            }
        });

        // Prevent clicks on filter content from bubbling up and affecting the toggle
        $('.block .filter-content').on('click', function(e) {
            e.stopPropagation();
        });

        // Initialize on page load
        initializeMobileFilters();

        // Handle window resize to show/hide filters appropriately
        $(window).on('resize', function() {
            initializeMobileFilters();
        });
    });
</script>