@using Nop.Core
@using Nop.Core.Domain.Catalog
@using Nop.Services.Localization
@inject ILocalizationService localizationService
@inject IWorkContext workContext
@inject CatalogSettings catalogSettings
@inject Nop.Web.Factories.ICatalogModelFactory catalogModelFactory
@{
    var languageId = (await workContext.GetWorkingLanguageAsync()).Id;
    var heroCategories = (await catalogModelFactory.PrepareHomepageCategoryModelsAsync()).Skip(1).Take(3).ToList();
}
<section class="bm-hero" aria-labelledby="bm-hero-title">
    <div class="bm-hero-copy">
        <span class="bm-eyebrow">BIROMARKET &mdash; @await localizationService.GetResourceAsync("Biromarket.Hero.Eyebrow", languageId, defaultValue: "LUCREAZĂ. CREEAZĂ. REPETĂ.")</span>
        <h1 id="bm-hero-title">@await localizationService.GetResourceAsync("Biromarket.Hero.Title", languageId, defaultValue: "Idei îndrăznețe. Instrumente pe măsură.")</h1>
        <p>@await localizationService.GetResourceAsync("Biromarket.Hero.Description", languageId, defaultValue: "Ideile bune încep cu instrumentele potrivite. Descoperă produse pentru birou, școală și proiectele tale creative.")</p>
        <div class="bm-hero-actions">
            <a class="bm-primary-link" href="@(heroCategories.Any() ? "#bm-home-categories" : Url.RouteUrl("ProductSearch"))">@await localizationService.GetResourceAsync("Biromarket.Hero.Shop", languageId, defaultValue: "Descoperă colecția") <span aria-hidden="true">&rarr;</span></a>
            @if (catalogSettings.NewProductsEnabled)
            {
                <a class="bm-text-link" href="@Url.RouteUrl("NewProducts")">@T("Products.NewProducts") <span aria-hidden="true">&rarr;</span></a>
            }
        </div>
        <div class="bm-hero-footnote"><span aria-hidden="true">+</span> @await localizationService.GetResourceAsync("Biromarket.Hero.Footnote", languageId, defaultValue: "Inspirație nouă, în fiecare zi.")</div>
    </div>
    <div class="bm-hero-visual">
        <span class="bm-hero-orbit" aria-hidden="true"></span>
        <span class="bm-hero-spark bm-spark-one" aria-hidden="true">+</span>
        <span class="bm-hero-spark bm-spark-two" aria-hidden="true">+</span>
        @if (heroCategories.Any())
        {
            <div class="bm-hero-products">
                @foreach (var category in heroCategories)
                {
                    <a href="@(Url.RouteUrl<Category>(new { SeName = category.SeName }))" class="bm-hero-product">
                        <img src="@category.PictureModel.ImageUrl" alt="" width="450" height="450" fetchpriority="high" />
                        <span>@category.Name <b aria-hidden="true">&nearr;</b></span>
                    </a>
                }
            </div>
        }
        else
        {
        <svg class="bm-desk-art" viewBox="0 0 600 540" fill="none" focusable="false" aria-hidden="true">
            <defs>
                <pattern id="bm-paper-lines" width="26" height="26" patternUnits="userSpaceOnUse"><path d="M0 25.5h26" stroke="#c8cbbb" stroke-width="1" /></pattern>
                <filter id="bm-desk-shadow" x="-30%" y="-30%" width="170%" height="170%"><feDropShadow dx="6" dy="18" stdDeviation="13" flood-color="#353b29" flood-opacity=".16" /></filter>
            </defs>
            <ellipse cx="310" cy="457" rx="218" ry="32" fill="#d3d2bb" opacity=".4" />
            <g transform="rotate(-14 275 288)" filter="url(#bm-desk-shadow)">
                <rect x="123" y="107" width="265" height="350" rx="12" fill="#e4e7d7" />
                <rect x="119" y="94" width="265" height="350" rx="12" fill="#fffef5" />
                <path d="M150 94v350" stroke="#ff7f00" stroke-width="4" />
                <rect x="170" y="140" width="183" height="260" fill="url(#bm-paper-lines)" />
                <path d="m181 184 18 17 33-39" stroke="#ff7f00" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M245 184h89M181 237h153M181 289h107" stroke="#6a725f" stroke-width="4" stroke-linecap="round" />
                <g stroke="#404a36" stroke-width="4" stroke-linecap="round">
                    <path d="M108 125h24M108 162h24M108 199h24M108 236h24M108 273h24M108 310h24M108 347h24M108 384h24M108 421h24" />
                </g>
            </g>
            <g transform="rotate(18 428 276)" filter="url(#bm-desk-shadow)">
                <rect x="417" y="102" width="22" height="292" rx="6" fill="#ff7f00" />
                <path d="M417 360h22v34l-11 28-11-28v-34Z" fill="#e4bb89" />
                <path d="m424 412 4 10 4-10" fill="#30362b" />
                <path d="M423 119v224" stroke="#ffd19c" stroke-width="4" />
                <rect x="417" y="102" width="22" height="27" rx="5" fill="#333e2c" />
            </g>
            <g transform="rotate(12 400 405)" filter="url(#bm-desk-shadow)">
                <rect x="323" y="337" width="156" height="132" rx="3" fill="#d7dfbd" />
                <path d="M344 364h80M344 383h110M344 402h90" stroke="#7c8869" stroke-width="3" stroke-linecap="round" />
                <path d="m443 437 10 9 16-19" stroke="#5c6a49" stroke-width="3" stroke-linecap="round" />
            </g>
            <g transform="rotate(-23 98 350)">
                <path d="M77 375v-72a17 17 0 0 1 34 0v79a27 27 0 0 1-54 0v-89a37 37 0 0 1 74 0v74" stroke="#f07812" stroke-width="8" stroke-linecap="round" />
            </g>
            <circle cx="475" cy="149" r="38" fill="#293222" />
            <path d="m458 149 12 12 23-26" stroke="#fff4d9" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        }
        <span class="bm-hero-edition" aria-hidden="true">BIROMARKET / LUCREAZĂ. CREEAZĂ. REPETĂ.</span>
    </div>
</section>
<div class="bm-discovery-bar">
    <a href="@Url.RouteUrl("ProductSearch")"><span aria-hidden="true">01</span>@T("Search")<b aria-hidden="true">&nearr;</b></a>
    @if (catalogSettings.RecentlyViewedProductsEnabled)
    {
        <a href="@Url.RouteUrl("RecentlyViewedProducts")"><span aria-hidden="true">02</span>@T("Products.RecentlyViewedProducts")<b aria-hidden="true">&nearr;</b></a>
    }
    <a href="@Url.RouteUrl("ContactUs")"><span aria-hidden="true">03</span>@T("ContactUs")<b aria-hidden="true">&nearr;</b></a>
</div>
