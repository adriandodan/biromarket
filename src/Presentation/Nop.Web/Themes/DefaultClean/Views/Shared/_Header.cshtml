@using Nop.Services.Localization
@inject ILocalizationService localizationService
@inject Nop.Core.IWorkContext workContext

<header class="header bm-header">
    <a class="skip" href="#main">@T("Header.SkipNavigation.Text")</a>
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderBefore })
    <div class="bm-utility">
        <div class="bm-utility-inner">
            <span class="bm-utility-brand"><span aria-hidden="true"></span> BIROMARKET</span>
            <div class="bm-utility-links">
                <a href="@Url.RouteUrl("CustomerOrders")">@T("Account.CustomerOrders")</a>
                <a href="@Url.RouteTopicUrl("shippinginfo")">@await localizationService.GetResourceAsync("Biromarket.Navigation.Delivery", (await workContext.GetWorkingLanguageAsync()).Id, defaultValue: "Livrare și retur")</a>
                <a href="@Url.RouteUrl("ContactUs")">@T("ContactUs") <span aria-hidden="true">&nearr;</span></a>
            </div>
            <div class="header-selectors-wrapper">
                @await Component.InvokeAsync(typeof(TaxTypeSelectorViewComponent))
                @await Component.InvokeAsync(typeof(CurrencySelectorViewComponent))
                @await Component.InvokeAsync(typeof(LanguageSelectorViewComponent))
                @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderSelectors })
            </div>
        </div>
    </div>
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderMiddle })
    <div class="header-lower bm-masthead">
        <div class="header-logo">
            <a class="bm-brand" href="@Url.RouteUrl("Homepage")" aria-label="Biromarket">
                @await Html.PartialAsync("_Brand")
            </a>
        </div>
        <div class="search-box store-search-box">
            @await Component.InvokeAsync(typeof(SearchBoxViewComponent))
        </div>
        <div class="header-links-wrapper">
            @await Component.InvokeAsync(typeof(HeaderLinksViewComponent))
            @await Component.InvokeAsync(typeof(FlyoutShoppingCartViewComponent))
        </div>
    </div>
    <section class="bm-contact-strip" aria-label="Informații de contact">
        <div class="bm-contact-strip-inner">
            <div class="bm-contact-item">
                <span class="bm-contact-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></svg>
                </span>
                <span class="bm-contact-copy"><b>Adresă</b><span>Șoseaua Pantelimon 255, Sector 2, București, 021613, România</span></span>
            </div>
            <a class="bm-contact-item" href="tel:+40727760000">
                <span class="bm-contact-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M7 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-3l-5-2-2 2a14 14 0 0 1-8-8l2-2-2-5Z" /></svg>
                </span>
                <span class="bm-contact-copy"><b>Telefon</b><span>+40 727 760 000</span></span>
            </a>
            <a class="bm-contact-item" href="mailto:office@biromarket.ro">
                <span class="bm-contact-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg>
                </span>
                <span class="bm-contact-copy"><b>Email</b><span>office@biromarket.ro</span></span>
            </a>
            <div class="bm-contact-item">
                <span class="bm-contact-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                </span>
                <span class="bm-contact-copy"><b>Program de lucru</b><span>Luni – Vineri: 08:00 – 16:00<br />Sâmbătă–Duminică: Închis</span></span>
            </div>
        </div>
    </section>
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderAfter })
</header>
